    "_class": "com.riil.model.platform.domain.MonitorTemplate",
    "alertDef": "<alertDef>\n  <rules>\n    <rule code=\"apache_ava\" name=\"apache\u670D\u52A1\u65E0\u6CD5\u8BBF\u95EE\" tile=\"apache\u5B9E\u4F8B\u5B95\" desc=\"Apache\u670D\u52A1\u5B95\uFF0C\u8BF7\u5C3D\u5FEB\u5904\u7406\n\" alertType=\"availAlert\" viewTemplate=\"415e7f47-6520-c10a-c113-aa4a9f2671c3\">\n      <reasons/>\n      <effects/>\n      <generates>\r\n    <generate alertLevel=\"1\">\r\n        <conditions>\r\n            <condition name=\"con1\" ruleType=\"metric\"\r\n                       function='countif'\r\n                       indicator='apache.run_status'\r\n                       option='=='\r\n                       threshold='-1'\r\n                       rangeNum='3'\r\n                       rangeType='times'\r\n                       countOpt='=='\r\n                       count='3'\r\n            />\r\n        </conditions>\r\n        <trigger rules=\"con1\"/>\r\n    </generate>\r\n</generates>\n      <recover type=\"3\">\r\n    <conditions>\r\n        <condition name=\"con1\" ruleType=\"metric\"\r\n                   function='last'\r\n                   indicator='apache.run_status'\r\n                   option='=='\r\n                   threshold='1'\r\n        />\r\n    </conditions>\r\n    <trigger rules=\"con1\"/>\r\n</recover>\n    </rule>\n  </rules>\n</alertDef>",
