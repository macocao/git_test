    "code": "m.apache_copy",
    "collectAttributes": [],
    "collectionDef": "<collectionDef>\r\n    <command type=\"HTTP_APACHE\" cmd=\"_connect\">\r\n        <fields>apache.run_status</fields>\r\n        <script><![CDATA[def (ok, time) = rows.last(); ok ? 1 : -1]]></script>\r\n    </command>\r\n    <command type=\"HTTP_APACHE\" cmd=\"script\">\r\n        <fields>apache.busy_workers,apache.bytes_per_req,apache.bytes_per_sec,apache.conns_async_closing,apache.conns_async_keep_alive,apache.conns_async_writing,apache.conns_total,apache.idle_workers,apache.req_per_sec,apache.server_uptime</fields>\r\n        <script><![CDATA[\r\n\r\nstatic def calData(html, pattern, group) {\r\n    def retVal = null\r\n    if (html) {\r\n        def matcher = pattern.matcher(html)\r\n        if (matcher.find() && matcher.groupCount() >= 1) {\r\n            retVal = matcher.group(group)\r\n        }\r\n    }\r\n    return retVal\r\n}\r\ndef statusHtml = runner.statusDoc.html()\r\n\r\ndef busy_workers = calData(statusHtml,~/\\sBusyWorkers: (\\S+)/,1)\r\n\r\ndef bytes_per_req = calData(statusHtml,~/\\sBytesPerReq: (\\S+)/,1)\r\n\r\ndef bytes_per_sec = calData(statusHtml,~/\\sBytesPerSec: (\\S+)/,1)\r\n\r\ndef conns_async_closing = calData(statusHtml,~/\\sConnsAsyncClosing: (\\S+)/,1)\r\n\r\ndef conns_async_keep_alive = calData(statusHtml,~/\\sConnsAsyncKeepAlive: (\\S+)/,1)\r\n\r\ndef conns_async_writing = calData(statusHtml,~/\\sConnsAsyncWriting: (\\S+)/,1)\r\n\r\ndef conns_total = calData(statusHtml,~/\\sConnsTotal: (\\S+)/,1)\r\n\r\ndef idle_workers = calData(statusHtml,~/\\sIdleWorkers: (\\S+)/,1)\r\n\r\ndef req_per_sec = calData(statusHtml,~/\\sReqPerSec: (\\S+)/,1)\r\n\r\ndef server_uptime = calData(statusHtml,~/\\sUptime: (\\S+)/,1)\r\n\r\n[busy_workers,bytes_per_req,bytes_per_sec,conns_async_closing,conns_async_keep_alive,conns_async_writing,conns_total,idle_workers,req_per_sec,server_uptime]\r\n        ]]></script>\r\n    </command>\r\n</collectionDef>",
    "complexMetricRules": [],
    "complexMetricRulesXml": "<complexMetricCalcRuleDef />",
    "components": [],
    "details": [],
    "discoverDef": "<discoverDef>\n    <visible>true</visible>\n     <command type=\"HTTP_APACHE\" cmd=\"script\" attrs=\"name,ipv4_address,port_number\">\n        <script><![CDATA[[\"${runner.ip}_${protocol.port}_apache\".toString(), runner.ip, protocol.port]]]></script>\n    </command>\n    <script type=\"HTTP_APACHE\">\n        <script><![CDATA[\nimport org.jsoup.Connection\nimport org.jsoup.Jsoup\n\nimport sun.misc.BASE64Encoder\n\nimport javax.net.ssl.HostnameVerifier\nimport javax.net.ssl.HttpsURLConnection\nimport javax.net.ssl.SSLContext\nimport javax.net.ssl.SSLSession\nimport javax.net.ssl.X509TrustManager\nimport java.security.SecureRandom\nimport java.security.cert.CertificateException\nimport java.security.cert.X509Certificate\n\ndef urlPrefix = generateUrlPrefix(ip, protocol.protocol, protocol.port)\ndef statusUrl = \"$urlPrefix/server-status?auto\"\nif (protocol[\"user\"]){\n    authHeader = basicAuthentication(protocol.user, protocol.password)\n}\nrunner.statusDoc =  reqAndParseHtml(protocol.protocol,statusUrl, protocol.timeout, authHeader)\nrunner.ip = ip\n\n\ndef basicAuthentication(String user,String password) {\n    if (user && password){\n        return \"Basic \" + (new BASE64Encoder()).encode((user+\":\"+password).getBytes());\n    }\n    return null\n}\n\nstatic def generateUrlPrefix(ip, protocol, port) {\n    def urlIp = ip.contains(\":\") ? \"[$ip]\" : ip\n    return \"$protocol://$urlIp:$port\"\n}\n\ndef reqAndParseHtml(protocol,url, timeout, authorHeader) {\n    Connection.Response resp = req(protocol,url, timeout, authorHeader)\n    return resp.parse();\n}\n\nprivate Connection.Response req(String protocol,String url, int timeout, String authorHeader) {\n     if (\"https\" == protocol){\n        trustEveryone()\n    }\n    def conn = Jsoup.connect(url).timeout(timeout).method(Connection.Method.GET)\n    conn.header(\"Accept-Language\", \"en-US,en\")\n    if (authorHeader){\n        conn.header(\"Authorization\", authorHeader)\n    }\n    def resp = conn.execute()\n    return checkRespStatus(url, resp) as Connection.Response\n}\n\nstatic def checkRespStatus(url, resp) {\n    if (resp.statusCode() == 200) return resp\n    String errMsg = \"statusCode fail, code: ${resp.statusCode()}, url:${url}, statusMessage:${resp.statusMessage()}\"\n    throw new IllegalStateException(errMsg)\n}\nstatic void trustEveryone() {\n    try {\n        HttpsURLConnection.setDefaultHostnameVerifier(new HostnameVerifier() {\n            public boolean verify(String hostname, SSLSession session) {\n                return true;\n            }\n        });\n\n        SSLContext context = SSLContext.getInstance(\"TLS\");\n        context.init(null, new X509TrustManager[] { new X509TrustManager() {\n            public void checkClientTrusted(X509Certificate[] chain, String authType) throws CertificateException {\n            }\n\n            public void checkServerTrusted(X509Certificate[] chain, String authType) throws CertificateException {\n            }\n\n            public X509Certificate[] getAcceptedIssuers() {\n                return new X509Certificate[0];\n            }\n        } }, new SecureRandom());\n        HttpsURLConnection.setDefaultSSLSocketFactory(context.getSocketFactory());\n    } catch (Exception e) {\n        // e.printStackTrace();\n    }\n}\n\n\n        ]]>\n        </script>\n    </script>\n</discoverDef>",
